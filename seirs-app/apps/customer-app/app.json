{
  "expo": {
    "name": "Seirs",
    "slug": "seirs-customer",
    "owner": "seye-xiv",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "seirscustomer",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.seirs.customer"
    },
    "android": {
      "package": "co.seirs.customer",
      "adaptiveIcon": {
        "backgroundColor": "#F5F5F0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 159,
          "resizeMode": "contain",
          "backgroundColor": "#F5F5F0",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#0A1F38"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Seirs needs your location to find nearby dispatch riders.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Seirs needs your photos so you can attach a picture of the package you are sending, which becomes proof of its condition at pickup.",
          "cameraPermission": "Seirs uses your camera to photograph the package you are sending, so there is a record of its condition before a rider collects it."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0F2B4C"
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7de6509a-fde9-46be-ab0b-a36a0b7bd002"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7de6509a-fde9-46be-ab0b-a36a0b7bd002"
    }
  }
}
