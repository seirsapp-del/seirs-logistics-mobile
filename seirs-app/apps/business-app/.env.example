# Google Maps key. Restrict it in Google Cloud Console by package name + SHA-1.
GOOGLE_MAPS_API_KEY=

# Google sign-in. The native module is already linked, so filling these in
# is a .env edit and a reload, NOT another native rebuild.
#   GOOGLE_WEB_CLIENT_ID  the "Web application" OAuth client from Google
#                         Cloud Console. This is the one the backend
#                         verifies against (its GOOGLE_CLIENT_ID must match).
#   GOOGLE_IOS_CLIENT_ID  only needed once iOS is built.
# Android also needs the app's SHA-1 registered against the Android OAuth
# client in the same Cloud project, or the flow fails at the native step.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
