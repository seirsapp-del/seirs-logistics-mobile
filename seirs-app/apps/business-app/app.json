{
  "expo": {
    "name": "Seirs Business",
    "slug": "seirs-business",
    "owner": "seye-xiv",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "seirsbusiness",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.seirs.business"
    },
    "android": {
      "package": "co.seirs.business",
      "adaptiveIcon": {
        "backgroundColor": "#F5F5F0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 159,
          "resizeMode": "contain",
          "backgroundColor": "#F5F5F0",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#0A1F38"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Seirs Business needs camera access to scan QR codes on packages."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Seirs Business needs access to your photos for document uploads."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Seirs Business needs your location to set pickup and dropoff points on the map.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0F2B4C"
        }
      ],
      "@react-native-google-signin/google-signin",
      "../../plugins/withNavBarContrast"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7c2abbf0-953d-4766-9280-621fda9219af"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7c2abbf0-953d-4766-9280-621fda9219af"
    }
  }
}
