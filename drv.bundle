 or bank account?',a:'Yes, but both are protected changes: submit the new details in the app and our team reviews them before they apply. Bank changes pause withdrawals until approved; vehicle changes need photos of the outside, inside, and plate.'},{topic:'Trips',q:'Can I decline a job request?',a:'Yes, you can decline any job request without penalty. Going into Wind Down mode stops new offers entirely while you finish your current jobs.'}],b=[{icon:'cash-outline',label:'Earnings'},{icon:'person-outline',label:'Account'},{icon:'car-outline',label:'Trips'},{icon:'shield-outline',label:'Safety'},{icon:'document-text-outline',label:'KYC'}];function x(){var e=(0,c.useRouter)(),t=(0,u.useColorScheme)(),x=h.Colors[null!=t?t:'light'],S='dark'===t,w=(0,l.useState)(''),j=(0,o.default)(w,2),C=j[0],I=j[1],v=(0,l.useState)(null),T=(0,o.default)(v,2),z=T[0],k=T[1],F=(0,l.useState)(null),R=(0,o.default)(F,2),W=R[0],q=R[1],A=f.filter(function(e){return(!z||e.topic===z)&&(!C.trim()||e.q.toLowerCase().includes(C.toLowerCase())||e.a.toLowerCase().includes(C.toLowerCase()))});return(0,p.jsxs)(i.SafeAreaView,{style:{flex:1,backgroundColor:x.background},edges:['top','bottom'],children:[(0,p.jsx)(n.StatusBar,{barStyle:S?'light-content':'dark-content'}),(0,p.jsxs)(n.View,{style:[y.header,{borderBottomColor:x.border}],children:[(0,p.jsx)(n.Pressable,{style:[y.backBtn,{backgroundColor:x.surfaceSecond}],onPress:function(){return e.back()},children:(0,p.jsx)(s.Ionicons,{name:"arrow-back",size:20,color:x.text})}),(0,p.jsx)(n.Text,{style:[y.title,{color:x.text}],children:"Help Center"}),(0,p.jsx)(n.View,{style:{width:36}})]}),(0,p.jsxs)(n.ScrollView,{showsVerticalScrollIndicator:!1,contentContainerStyle:y.content,keyboardShouldPersistTaps:"handled",children:[(0,p.jsxs)(n.View,{style:[y.searchWrap,{backgroundColor:x.surfaceSecond,borderColor:x.border}],children:[(0,p.jsx)(s.Ionicons,{name:"search-outline",size:18,color:x.textThird}),(0,p.jsx)(n.TextInput,{style:[y.searchInput,{color:x.text}],pl